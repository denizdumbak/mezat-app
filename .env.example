# Copy to .env and fill in. .env is git-ignored.
# Only PUBLIC values go here; they are compiled into the app.
# Never put LIVEKIT_API_KEY / LIVEKIT_API_SECRET here: they live in Supabase secrets.

# Local Supabase: printed by `supabase start` (API URL and anon key).
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-with-anon-key

# LiveKit Cloud project URL (used from M4 on).
LIVEKIT_URL=wss://your-project.livekit.cloud
